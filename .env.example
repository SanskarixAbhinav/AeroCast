# ==============================================================================
# WeatherGPT Environment Configuration
# ==============================================================================
# NOTE: Placeholders only. Do NOT commit actual secrets or API keys.

# ------------------------------------------------------------------------------
# Backend Secrets (Set in Supabase via CLI: `supabase secrets set ...`)
# ------------------------------------------------------------------------------
# Required: Google Gemini API Key
GEMINI_API_KEY=

# Optional: Gemini model override (defaults to gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# Note: SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are automatically injected
# into hosted Supabase Edge Functions.

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Set in Vercel / Netlify / .env for Vite)
# ------------------------------------------------------------------------------
# Required for frontend to reach the backend Edge Functions:
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
